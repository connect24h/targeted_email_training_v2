[Unit]
Description=TET v2 Education Reminder (nag incomplete learners)
After=network.target

[Service]
Type=oneshot
User=training
Group=www-data
ExecStart=/usr/bin/php /var/www/html/tet2/db/edu_reminder.php
StandardOutput=append:/opt/training/tet2-data/edu-reminder.log
StandardError=append:/opt/training/tet2-data/edu-reminder.log
