[Unit]
Description=TET v2 Report Ingest (Apache access.log -> phishing open/click/auth events)
After=network.target

[Service]
Type=oneshot
User=training
Group=www-data
# access.log (root:adm 640) を読むため adm、報告 Maildir (owner:vmail 640) を読むため vmail を付与する。
SupplementaryGroups=adm vmail
# 報告メール取込(report@gwin.gr.cojp.online の Maildir)。導入直後は match_only で照合だけ記録し、
# 実際の転送形式で回収率を確認してから normal に切り替える(2026-09-06)。
Environment=TET2_REPORT_MAILDIR=/home/report/Maildir
Environment=TET2_REPORT_INGEST_MODE=match_only
ExecStart=/usr/bin/php /var/www/html/tet2/db/report_ingest.php
StandardOutput=append:/opt/training/tet2-data/report-ingest.log
StandardError=append:/opt/training/tet2-data/report-ingest.log
