[Unit]
Description=TET v2 Delivery Ingest (mail.log bounces, DSN and replies -> delivery_state / reply events)
After=network.target

# 有効化は利用者の承認が要る(deploy/README.md の「測定の正しさ(段B1)」)。migration 20261025-measurement-b1 を先に適用する。
# メールは送らない。mail.log と訓練の送信元の Maildir を読み、DB の宛先の状態と events の reply を書くだけ。

[Service]
Type=oneshot
User=training
Group=www-data
# mail.log (syslog:adm 640) を読むため adm、訓練の送信元の Maildir (各アカウント:vmail 640) を読むため vmail を付与する。
SupplementaryGroups=adm vmail
Environment=TET2_MAIL_LOG=/var/log/mail.log
Environment=TET2_REPORT_MAILDIR=/home/report/Maildir
# 読み書きの場所は変えずに足せる守りだけを入れる(権限を上げさせない、一時ファイルを分ける)。
NoNewPrivileges=true
PrivateTmp=true
ExecStart=/usr/bin/php /var/www/html/tet2/db/delivery_ingest.php
StandardOutput=append:/opt/training/tet2-data/delivery-ingest.log
StandardError=append:/opt/training/tet2-data/delivery-ingest.log
